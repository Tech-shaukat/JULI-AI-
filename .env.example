# Firebase AI Logic (Live, Chat, Image Create/Edit) uses Firebase App Check for attestation.
# MAPS_API_KEY: Required for embedded Google Maps Platform map rendering in-app.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# VIDEO_STUDIO_API_KEY: Required for Gemini Interactions API video generation (gemini-omni-1.2-flash).
VIDEO_STUDIO_API_KEY=YOUR_VIDEO_STUDIO_API_KEY
